{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hook-session-start.mjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node scripts/hook-protect.mjs" }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "timeout": 10,
            "command": "node \"$CLAUDE_PROJECT_DIR/.harness/danger-guard.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node scripts/hook-format.mjs" },
          { "type": "command", "command": "node scripts/check-guardrails.mjs" },
          { "type": "command", "command": "node scripts/check-references.mjs" }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "timeout": 10,
            "command": "node \"$CLAUDE_PROJECT_DIR/.harness/danger-guard.mjs\" --post"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node scripts/hook-gate.mjs" },
          {
            "type": "command",
            "shell": "bash",
            "timeout": 10,
            "command": "node \"$CLAUDE_PROJECT_DIR/.harness/turn-end.mjs\""
          }
        ]
      }
    ]
  }
}
